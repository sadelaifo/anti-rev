#!/bin/bash
# antirev-mount — mount an encrypted .enc/ subtree as a decrypted antirevfs view.
#
# Usage:
#   antirev-mount [--passdata] <lowerdir> <mountpoint> [passthrough-exts]
#
#   --passdata        serve ANY non-ANTREV01 file as plaintext passthrough — for
#                     complete mixed-content read-only trees (antirev-fs-pack.py
#                     with mirror_plaintext).  Supersedes [passthrough-exts].
#   <lowerdir>        ciphertext tree (e.g. /root/proj/.enc/lib)
#   <mountpoint>      where the plaintext view appears (e.g. /root/proj/lib)
#   passthrough-exts  optional colon-separated extensions served verbatim
#                     (e.g. json:md) for mixed-content directories
#
# No key is needed to mount: each encrypted file embeds its own AES key in a
# trailer, which the module reads at decrypt time (antirevfs has no mount-time
# key / keyring lookup).  Pack the tree with antirev-fs-pack.py (it writes the
# embedded-key container) or protect.py encrypt-lib --embed-key.
set -euo pipefail

die() { echo "antirev-mount: $*" >&2; exit 1; }

passdata=0
if [[ "${1:-}" == "--passdata" ]]; then passdata=1; shift; fi

[[ $# -ge 2 ]] || die "usage: antirev-mount [--passdata] <lowerdir> <mountpoint> [passthrough-exts]"
lower="$1"; mp="$2"; pass="${3:-}"

[[ -d "$lower" ]] || die "lowerdir not a directory: $lower"
[[ -d "$mp" ]]    || die "mountpoint not a directory: $mp"

opts="ro"
[[ "$passdata" -eq 1 ]] && opts="$opts,passdata"
[[ -n "$pass" ]] && opts="$opts,passthrough=$pass"
[[ -n "${ANTIREV_MOUNT_OPTS:-}" ]] && opts="$opts,$ANTIREV_MOUNT_OPTS"

modprobe antirevfs 2>/dev/null || true
exec mount -t antirevfs -o "$opts" "$lower" "$mp"

#!/bin/bash
# vcache-mount-ro — mount an encrypted .enc/ subtree as a decrypted vcachefs view.
#
# Usage:
#   vcache-mount-ro [--passdata] [--writable] <lowerdir> <mountpoint> [passthrough-exts]
#
#   --passdata        serve ANY non-ANTREV01 file as plaintext passthrough — for
#                     complete mixed-content read-only trees (vcache-pack.py
#                     with mirror_plaintext).  Supersedes [passthrough-exts].
#   --writable        gated plaintext write passthrough (6.8+ only): an
#                     authorized process may create/write/delete PLAINTEXT files
#                     in-place; encrypted files stay immutable (read-only).  No
#                     overlay needed.  Drops the mount's SB_RDONLY.  See CLAUDE.md
#                     "Native writable passthrough".  Usually paired with
#                     --passdata so the app's scratch reads back.
#   <lowerdir>        ciphertext tree (e.g. /root/proj/.enc/lib)
#   <mountpoint>      where the plaintext view appears (e.g. /root/proj/lib)
#   passthrough-exts  optional colon-separated extensions served verbatim
#                     (e.g. json:md) for mixed-content directories
#
# No key is needed to mount: each encrypted file embeds its own AES key in a
# trailer, which the module reads at decrypt time (vcachefs has no mount-time
# key / keyring lookup).  Pack the tree with vcache-pack.py (it writes the
# embedded-key container) or protect.py encrypt-lib --embed-key.
set -euo pipefail

die() { echo "vcache-mount-ro: $*" >&2; exit 1; }

passdata=0
writable=0
while [[ "${1:-}" == --* ]]; do
	case "$1" in
		--passdata) passdata=1; shift;;
		--writable) writable=1; shift;;
		*) die "unknown option: $1";;
	esac
done

[[ $# -ge 2 ]] || die "usage: vcache-mount-ro [--passdata] [--writable] <lowerdir> <mountpoint> [passthrough-exts]"
lower="$1"; mp="$2"; pass="${3:-}"

[[ -d "$lower" ]] || die "lowerdir not a directory: $lower"
[[ -d "$mp" ]]    || die "mountpoint not a directory: $mp"

# A writable mount must NOT carry 'ro' (the module drops SB_RDONLY only when the
# 'writable' option is present; a conflicting 'ro' would re-assert it via the VFS).
opts=""
if [[ "$writable" -eq 1 ]]; then opts="writable"; else opts="ro"; fi
[[ "$passdata" -eq 1 ]] && opts="$opts,passdata"
[[ -n "$pass" ]] && opts="$opts,passthrough=$pass"
[[ -n "${VCACHE_MOUNT_OPTS:-}" ]] && opts="$opts,$VCACHE_MOUNT_OPTS"

modprobe vcachefs 2>/dev/null || true
exec mount -t vcachefs -o "$opts" "$lower" "$mp"

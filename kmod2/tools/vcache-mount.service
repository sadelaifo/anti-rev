# vcache-mount.service — real-mode (native machine) mount at boot.
#
# No container: mount vcachefs in-place over the local bin/lib once at boot,
# BEFORE the business app starts.  oneshot (runs, mounts, exits; the mounts
# persist).  Use this on the real appliance / real ARM64 slave hardware.
#
# Install (adjust the ExecStart path):
#   install -m0755 vcache-mount.sh /opt/vcache/
#   install -m0644 vcache-mount.service     /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable vcache-mount.service          # runs at next boot before the app
#
# If you know the business unit name, uncomment Before= so ordering is enforced.

[Unit]
Description=vcache real-mode in-place mount (decrypt bin/lib on this host)
DefaultDependencies=yes
# Before=your-business-app.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=AREV_MODE=real
# Environment=AREV_KO=/opt/vcache/vcachefs.ko
ExecStart=/opt/vcache/vcache-mount.sh --mode real up
ExecStop=/opt/vcache/vcache-mount.sh --mode real down

[Install]
WantedBy=multi-user.target

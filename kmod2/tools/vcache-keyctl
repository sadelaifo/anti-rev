#!/bin/bash
# vcache-keyctl — load an AES-256 key into the kernel keyring.
#
# DEPRECATED for vcachefs: the module no longer reads a mount-time key.  Each
# encrypted file now embeds its own key in a trailer (see vcache-pack.py /
# protect.py encrypt-lib --embed-key), which the module reads at decrypt time,
# so `vcache-mount-ro`/`vcache-mount-rw` need no unlock step.  This tool is kept
# only for legacy/experimental flows; it has no effect on a current vcachefs
# mount.
#
# (Historical behaviour) The module used to look up a "user"-type key named
# "vcachefs:default" in the mounting process's keyrings; this tool installed
# that key so `mount -t vcachefs` found it.
#
# Usage:
#   vcache-keyctl unlock --keyfile <hexkeyfile>   # 64 hex chars (protect.py keyfile)
#   vcache-keyctl unlock-from-tpm                 # placeholder for TPM/dongle unseal
#   vcache-keyctl status                          # show whether the key is present
#   vcache-keyctl clear                           # revoke the key from the keyring
#
# Keyring: the session keyring (@s).  The kernel's request_key() from the mount
# path always searches the mounting task's session keyring, so the unlock and
# the mount must run in the same session (e.g. the same systemd unit / shell).
# The per-UID @u keyring is NOT reliable here: sudo/login (pam_keyinit) installs
# a fresh session keyring that does not link @u, so a key added to @u is invisible
# to request_key.  For an unlock-now / mount-later-in-another-session flow, prefer
# the key= mount option in fstab, or link @u into the unit's session keyring.
set -euo pipefail

DESC="vcachefs:default"
KEYRING="@s"

die() { echo "vcache-keyctl: $*" >&2; exit 1; }

find_key() { keyctl search "$KEYRING" user "$DESC" 2>/dev/null || true; }

cmd_unlock() {
	local keyfile=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--keyfile) keyfile="${2:-}"; shift 2;;
			*) die "unknown arg: $1";;
		esac
	done
	[[ -n "$keyfile" ]] || die "unlock requires --keyfile <hexkeyfile>"
	[[ -r "$keyfile" ]] || die "cannot read keyfile: $keyfile"

	local hex
	hex="$(tr -d '[:space:]' < "$keyfile")"
	[[ "${#hex}" -eq 64 ]] || die "keyfile must contain 64 hex chars (32-byte AES-256 key), got ${#hex}"
	[[ "$hex" =~ ^[0-9a-fA-F]+$ ]] || die "keyfile is not hex"

	# padd reads the raw payload from stdin (binary-safe, unlike `add`).
	echo -n "$hex" | xxd -r -p | keyctl padd user "$DESC" "$KEYRING" >/dev/null
	echo "vcache-keyctl: key '$DESC' installed in $KEYRING"
}

cmd_unlock_from_tpm() {
	die "unlock-from-tpm not implemented — wire up your TPM/PKCS#11/dongle unseal here, then 'keyctl padd user $DESC $KEYRING'"
}

cmd_status() {
	local id; id="$(find_key)"
	if [[ -n "$id" ]]; then
		echo "vcache-keyctl: key '$DESC' present (id $id)"
	else
		echo "vcache-keyctl: key '$DESC' NOT present"
		return 1
	fi
}

cmd_clear() {
	local id; id="$(find_key)"
	[[ -n "$id" ]] || { echo "vcache-keyctl: no key to clear"; return 0; }
	keyctl revoke "$id" >/dev/null 2>&1 || true
	keyctl unlink "$id" "$KEYRING" >/dev/null 2>&1 || true
	echo "vcache-keyctl: key '$DESC' cleared"
}

[[ $# -ge 1 ]] || die "usage: vcache-keyctl {unlock --keyfile F|unlock-from-tpm|status|clear}"
sub="$1"; shift
case "$sub" in
	unlock)          cmd_unlock "$@";;
	unlock-from-tpm) cmd_unlock_from_tpm "$@";;
	status)          cmd_status "$@";;
	clear)           cmd_clear "$@";;
	*) die "unknown subcommand: $sub";;
esac

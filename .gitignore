# Build output
build/

# Key files (contain secrets)
*.key

# Benchmark generated projects (large binaries + 100MB data file)
bench/*project/

# Compiled artifacts
*.o
*.so
*.protected

# Python cache
__pycache__/
*.pyc

# Test scratch dirs
tests/**/_workdir/
tests/**/out_*/

# Local Claude Code settings (per-machine)
.claude/settings.local.json

# Generated presentation
*.pptx

# Debug symbol files
*.debug

# Core dumps
core
core.*

# Editor / IDE
.vscode/
.idea/

# CMake tooling
compile_commands.json

# qemu: exclude system-emulation firmware/blobs (linux-user build doesn't need them)
qemu-11-memleak-fix/qemu-11-memleak-fix/roms/
# qemu: test SSH private keys blocked by GitHub push protection (not build inputs)
qemu-11-memleak-fix/qemu-11-memleak-fix/tests/keys/id_rsa
qemu-11-memleak-fix/qemu-11-memleak-fix/tests/keys/vagrant
qemu-11-memleak-fix/qemu-11-memleak-fix/tests/lcitool/libvirt-ci/tests/data/utils/ssh_keypair/in/id_ed25519

# WSL build scratch + artifacts (rebuildable; do not commit)
.wsl_build.sh
.wsl_build.log
glib-*.tar.xz
qemu-aarch64-static

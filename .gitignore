# Build output
build/

# Key files (contain secrets)
*.key

# Benchmark generated projects (large binaries + 100MB data file)
bench/*project/

# Compiled artifacts
*.o
*.so
*.protected

# Python cache
__pycache__/
*.pyc

# Test scratch dirs
**/tests/**/_workdir/
**/tests/**/out_*/

# Local Claude Code settings (per-machine)
.claude/settings.local.json

# Generated presentation
*.pptx

# Debug symbol files
*.debug

# Core dumps
core
core.*

# Editor / IDE
.vscode/
.idea/

# CMake tooling
compile_commands.json

# WSL build scratch + artifacts (rebuildable; do not commit)
.wsl_build.sh
.wsl_build.log
glib-*.tar.xz
/qemu-aarch64-static

# In-source CMake build artifacts (proper build is out-of-source in build/).
# These names are ONLY ever CMake-generated, so ignore them at any depth:
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
# Generated Makefiles live only at the repo root and in daemon-shim/ (both are
# pure CMake projects). Anchored so the hand-written fusefs/ and kmod2/ Makefiles
# are NOT ignored:
/Makefile
/daemon-shim/Makefile
# daemon-shim codegen outputs when CMAKE_BINARY_DIR is the source root:
/antirev_shim_blob.h
/antirev_shim_blob_aarch64.h
/runtime_paths.c
/obf/

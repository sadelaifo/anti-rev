int antirev_dir_name_matches_us(const char *name, int *out_pid) {
    /* OBFSTR is the top-level call here — not nested in snprintf —
     * so obfstr_gen DOES rewrite it to _OBF(...). */
    const char *prefix = OBFSTR("@ANTIREV_TMP_PREFIX@");

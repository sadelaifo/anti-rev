{
  "_comment": "Case-level whitelist with auto-binding inside each case. The `binding` block defines templates for where to find vars and expected values; `test_cases` lists which cases to actually run. Each entry can be a bare string (pure auto-bind) or a dict (auto-bind + manual override / label).",

  "formula_config": {
    "path":         "example_config.json",
    "exprs_at":     "expr",
    "constants_at": ["physics_consts", "calibration_consts"],
    "subexprs_at":  "subexprs"
  },

  "data_sources": {
    "inputs":   "example_inputs.json",
    "expected": "example_expected.json"
  },

  "compile_options": { "jit": false },
  "tolerance": 1e-9,

  "binding": {
    "vars_from":     "inputs.{case}",
    "expected_from": "expected.{case}"
  },

  "test_cases": [
    "case_nominal",
    "case_zero_i",
    "case_zero_v",
    "case_negative",

    { "case": "case_hot",
      "label": "high temperature — t_corr should rise above 1" },

    { "case": "case_cold",
      "label": "cold extreme",
      "vars":  { "t": -50.0 } },

    { "label": "purely manual sanity check (no `case` field)",
      "vars":     { "v": 100.0, "i": 1.0, "t": 50.0 },
      "expected": { "0": 50.0 } }
  ]
}
